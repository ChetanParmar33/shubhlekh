# Copy to server/.env and fill in. Never commit the real .env.
NODE_ENV=production
PORT=8800
PUBLIC_URL=https://your-domain.com          # used for share links and WhatsApp previews
BRAND_NAME=Shubhlekh
SUPPORT_EMAIL=support@your-domain.com
SUPPORT_WHATSAPP=919876543210                # your team's WhatsApp number with country code — used by every "WhatsApp us" button
ADMIN_EMAILS=you@your-domain.com             # comma-separated; these accounts see /dashboard/team (paid orders + customer numbers)
SESSION_SECRET=change-me-to-a-long-random-string-of-32-plus-characters
DATABASE_URL=                                # Postgres (e.g. Neon pooled URL, sslmode=verify-full). Empty locally → PGlite in DATA_DIR

# Razorpay (Dashboard → Settings → API Keys). Without these, production shows "payments not set up".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=                     # Webhook URL: https://your-domain.com/api/webhooks/razorpay (event: payment.captured)

# Local development only: DEV_PAYMENTS=1 shows a "Complete test payment" button instead of Razorpay.
# DEV_PAYMENTS=1
# DATA_DIR=./data                            # local PGlite database + uploaded photos (Netlify uses Postgres + Blobs)
